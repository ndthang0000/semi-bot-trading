# ── Environment ───────────────────────────────────────────────────────────────
# "development" → Telegram messages get [DEV] prefix, safe for testing.
# "production"  → no prefix, real live trading.
ENVIRONMENT="development"

MT5_LOGIN="000000000"
MT5_PASSWORD="replace-me"
MT5_SERVER="Exness-MT5Real36"
# Optional but recommended on Windows VPS/services. Point to terminal64.exe,
# not only the install folder.
MT5_PATH="C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe"
MT5_SYMBOL="XAUUSDm"
MT5_MAGIC="260612"
MT5_SERVER_UTC_OFFSET_HOURS="0"

TELEGRAM_TOKEN="replace-me"
TELEGRAM_CHAT_ID="replace-me"

# Keep false while testing Telegram/MT5 connectivity. Set true only when the
# live worker may send real market orders.
EXECUTION_ENABLED="false"
MAX_OPEN_POSITIONS_PER_SYMBOL="1"
MAX_TRADES_PER_DAY="10"
LIVE_POLL_SECONDS="15"
# false = only evaluate setups when an M15 candle closes.
# true  = evaluate every poll using MT5's still-forming live candle, useful for
# intrabar zone touches/rejections but more aggressive for live execution.
LIVE_EVALUATE_INTRABAR="false"
# In multi-account mode, keep only one worker responsible for writing shared
# candles and detector outputs. The account-only worker can set both to false.
LIVE_SYNC_CANDLES="true"
LIVE_RUN_DETECTORS="true"
CHART_URL_BASE="http://127.0.0.1:5173"

# ── Partial TP / Break-even ─────────────────────────────────────────────────
# When an open live trade reaches +1.25R, close 50% and move the remaining
# position's SL to entry. This reduces pressure without changing the final TP.
PARTIAL_TAKE_PROFIT_ENABLED="true"
PARTIAL_TAKE_PROFIT_R="1.0"
PARTIAL_TAKE_PROFIT_FRACTION="0.4"
PARTIAL_TAKE_PROFIT_BE_BUFFER="0.0"

# ── Weekend flatten ─────────────────────────────────────────────────────────
# Default rule for XAUUSD live execution:
# - stop opening new trades after Friday 12:00 New York time
# - cancel pending orders and close open positions after Friday 15:30 New York time
# - allow the new trading week again after Sunday 17:00 New York time
# Friday 15:30 New York is usually Saturday 02:30 Vietnam while New York is in DST.
WEEKEND_FLATTEN_ENABLED="true"
WEEKEND_FLATTEN_TIMEZONE="America/New_York"
WEEKEND_NO_NEW_TRADES_TIME="12:00"
WEEKEND_FLATTEN_TIME="15:30"
MANUAL_TRADE_GUARD_SECONDS="1.0"

# ── Risk Management ──────────────────────────────────────────────────────────
# Account profile controls default risk rules:
#   personal        – 2% risk/trade, 6% max daily loss, 20% max drawdown
#   personal_cent   – 2% risk/trade, 6% max daily loss, 20% max drawdown
#   ftmo_challenge  – 1% risk/trade, 5% max daily loss, 10% max drawdown
#   the5ers         – 1% risk/trade, 4% max daily loss, 8% max drawdown
# Manual AI uses its own lower risk: 1.5% personal, 0.75% prop firm.
ACCOUNT_PROFILE="personal_cent"
# Exness cent accounts often report 1000 USD as 100000 USC. Keep this at 0.01
# for cent accounts so risk sizing uses the USD-equivalent balance.
ACCOUNT_BALANCE_SCALE="0.01"
# Original challenge/account size. Required for an exact FTMO-style daily %.
# ACCOUNT_INITIAL_BALANCE="100000"
# CE(S)T with automatic daylight-saving changes.
DAILY_RESET_TIMEZONE="Europe/Prague"

# Human-readable label for this MT5 account shown in the dashboard.
# Use a descriptive name — e.g. "Exness Personal", "FTMO Challenge #1".
# Must be unique across worker instances when running multi-account.
ACCOUNT_LABEL="Exness Cent"

# Optional: override the profile's default risk-per-trade (%). Leave unset to
# use the profile default shown above.
# RISK_PER_TRADE_PCT="2.0"

# Fallback fixed lot size used ONLY if risk calculation fails (e.g. MT5
# account_info unavailable). Set conservatively.
LIVE_ORDER_VOLUME="0.01"

# FTMO setup should live in a separate untracked file such as .env.ftmo.
# Never commit real FTMO credentials. Start with EXECUTION_ENABLED=false.
#
# ENVIRONMENT="development"
# MT5_LOGIN="replace-with-ftmo-login"
# MT5_PASSWORD="replace-with-local-secret"
# MT5_SERVER="FTMO-Demo"
# MT5_PATH="C:\Program Files\MetaTrader 5 FTMO\terminal64.exe"
# MT5_SYMBOL="XAUUSD"
# MT5_MAGIC="260613"
# ACCOUNT_LABEL="FTMO Demo"
# ACCOUNT_PROFILE="ftmo_challenge"
# ACCOUNT_BALANCE_SCALE="1.0"
# ACCOUNT_INITIAL_BALANCE="100000"
# FTMO_PHASE="evaluation" # set to funded only for a funded FTMO Account
# FTMO_ACCOUNT_TYPE="standard" # standard | swing
# FTMO_NEWS_BUFFER_MINUTES="5"
# FTMO_NEWS_CALENDAR_MAX_AGE_HOURS="36"
# FTMO_NEWS_FLATTEN_ENABLED="true"
# LIVE_SYNC_CANDLES="false"
# LIVE_RUN_DETECTORS="false"
# EXECUTION_ENABLED="false"
# RISK_PER_TRADE_PCT="1.0"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random secret key (keep this secret!):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace-with-random-hex-64-chars"

# Admin login (username is fixed; set your own password hash below)
ADMIN_USERNAME="admin"

# Generate your password hash:
#   semi-bot hash-password
# Then paste the output here.
ADMIN_PASSWORD_HASH=""

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# For local dev the defaults below are fine.
# For VPS: add your public URL, e.g. "https://trading.example.com"
# If frontend is served by FastAPI itself (same origin), CORS is not needed.
# ALLOWED_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
