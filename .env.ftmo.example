# FTMO live worker env. Keep real credentials local and untracked.
ENVIRONMENT="development"

MT5_LOGIN="replace-with-ftmo-login"
MT5_PASSWORD="replace-with-local-secret"
MT5_SERVER="FTMO-Demo"
MT5_PATH="C:\Program Files\MetaTrader 5 FTMO\terminal64.exe"
MT5_SYMBOL="XAUUSD"
MT5_MAGIC="260613"
# FTMO server wall clock is UTC+3 for this account. The worker uses this for
# history timestamps and pending-order expiry. Change it when the broker changes
# its server offset (commonly around daylight-saving transitions).
MT5_SERVER_UTC_OFFSET_HOURS="3"

ACCOUNT_LABEL="FTMO Demo"
ACCOUNT_PROFILE="ftmo_challenge"
ACCOUNT_BALANCE_SCALE="1.0"

# News restrictions apply only after promotion to a funded Standard FTMO
# Account. Keep "evaluation" during Challenge/Verification. Swing accounts are
# exempt, so use FTMO_ACCOUNT_TYPE="swing" when applicable.
FTMO_PHASE="evaluation"
FTMO_ACCOUNT_TYPE="standard"
FTMO_NEWS_BUFFER_MINUTES="5"
FTMO_NEWS_CALENDAR_MAX_AGE_HOURS="36"
FTMO_NEWS_FLATTEN_ENABLED="true"

TELEGRAM_TOKEN="replace-me"
TELEGRAM_CHAT_ID="replace-me"
CHART_URL_BASE="http://127.0.0.1:5173"

EXECUTION_ENABLED="false"
RISK_PER_TRADE_PCT="1.0"
LIVE_ORDER_VOLUME="0.01"
MAX_OPEN_POSITIONS_PER_SYMBOL="1"
MAX_TRADES_PER_DAY="5"
MAX_ENTRY_DRIFT_PRICE="2.0"
MAX_SPREAD_PRICE="2.0"
LIVE_POLL_SECONDS="15"
LIVE_POLL_AT_SECONDS="1,16,31,46"

# Secondary account worker reads shared candles/zones/signals from DB.
LIVE_SYNC_CANDLES="false"
LIVE_RUN_DETECTORS="false"
LIVE_EVALUATE_INTRABAR="false"

PARTIAL_TAKE_PROFIT_ENABLED="true"
PARTIAL_TAKE_PROFIT_R="1.25"
PARTIAL_TAKE_PROFIT_FRACTION="0.5"
PARTIAL_TAKE_PROFIT_BE_BUFFER="0.0"

WEEKEND_FLATTEN_ENABLED="true"
WEEKEND_FLATTEN_TIMEZONE="America/New_York"
WEEKEND_NO_NEW_TRADES_TIME="12:00"
WEEKEND_FLATTEN_TIME="15:30"
MANUAL_TRADE_GUARD_SECONDS="1.0"
